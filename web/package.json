{
  "name": "celine-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node --no-warnings --experimental-strip-types src/lib/useReveal.check.mjs && node --no-warnings --experimental-strip-types src/lib/speechText.check.mjs && node --no-warnings --experimental-strip-types src/lib/onboardingModel.check.mjs && node --no-warnings --experimental-strip-types src/lib/featureSteps.check.mjs && node --no-warnings --experimental-strip-types src/lib/toolPlaces.check.mjs && npm run lint",
    "lint": "eslint --max-warnings 0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@novnc/novnc": "^1.7.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
